{
  "name": "@rdlabo/workers-hono-kit",
  "version": "0.12.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "description": "Infrastructure toolkit for building APIs on Hono + Cloudflare Workers: Firebase ID-token verification (jose), AWS Secrets Manager (aws4fetch), ETag/validation/zod-coerce middleware, deadlock retry, and shared HTTP helpers.",
  "author": "Masahiko Sakakibara<sakakibara@rdlabo.jp>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rdlabo-dev/workers-hono-kit.git"
  },
  "bugs": {
    "url": "https://github.com/rdlabo-dev/workers-hono-kit/issues"
  },
  "homepage": "https://docs.rdlabo.dev/projects/workers-hono-kit",
  "keywords": [
    "hono",
    "cloudflare-workers",
    "workers",
    "edge",
    "firebase",
    "jose",
    "aws-secrets-manager",
    "middleware",
    "etag",
    "zod",
    "nestjs"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^20.19.0 || ^22.13.0 || >=24.0.0",
      "onFail": "error"
    }
  },
  "files": [
    "dist",
    "scripts",
    "!scripts/publish-packages*.mjs",
    "!scripts/sync-release-versions*.mjs",
    "docs",
    "!src/**/*.spec.ts"
  ],
  "bin": {
    "workers-hono-kit-sync-dev-aws": "scripts/sync-dev-aws.mjs",
    "workers-hono-kit-check-subrequest-fanout": "scripts/check-subrequest-fanout.mjs",
    "workers-hono-kit-db-baseline": "scripts/db-baseline.mjs",
    "workers-hono-kit-check-realtime-bundle": "scripts/check-realtime-bundle.mjs",
    "workers-hono-kit-query-realtime-do-metrics": "scripts/query-realtime-do-metrics.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "import": "./dist/db/index.js",
      "default": "./dist/db/index.js"
    },
    "./mysql": {
      "types": "./dist/mysql/index.d.ts",
      "import": "./dist/mysql/index.js",
      "default": "./dist/mysql/index.js"
    },
    "./business-time": {
      "types": "./dist/business-time/index.d.ts",
      "import": "./dist/business-time/index.js",
      "default": "./dist/business-time/index.js"
    },
    "./offline": {
      "types": "./dist/offline/index.d.ts",
      "import": "./dist/offline/index.js",
      "default": "./dist/offline/index.js"
    },
    "./realtime": {
      "types": "./dist/realtime/index.d.ts",
      "import": "./dist/realtime/index.js",
      "default": "./dist/realtime/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "npm run build --workspace @rdlabo/workers-timezone && npm run build --workspace @rdlabo/workers-mysql && node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "npm run typecheck --workspace @rdlabo/workers-timezone && npm run typecheck --workspace @rdlabo/workers-mysql && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:package": "node scripts/workspace-package-smoke.mjs",
    "test:release": "node --test scripts/publish-packages.test.mjs scripts/sync-release-versions.test.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"packages/**/*.{ts,mjs,md,json}\" \"*.mjs\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"packages/**/*.{ts,mjs,md,json}\" \"*.mjs\" \"scripts/**/*.mjs\"",
    "release": "np --no-tests --no-publish",
    "version": "node scripts/sync-release-versions.mjs"
  },
  "dependencies": {
    "stripe": "^20.4.1"
  },
  "peerDependencies": {
    "@hono/zod-validator": "^0.8.0",
    "@rdlabo/workers-mysql": "^0.1.0",
    "@rdlabo/workers-timezone": "^0.1.0",
    "ai": "^6.0.0",
    "ai-gateway-provider": "^3.1.0",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.0",
    "jose": "^6.2.0",
    "zod": "^4.4.0"
  },
  "peerDependenciesMeta": {
    "@rdlabo/workers-mysql": {
      "optional": true
    },
    "@rdlabo/workers-timezone": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^3.0.84",
    "@ai-sdk/openai": "^3.0.71",
    "@angular-eslint/template-parser": "^21.4.0",
    "@angular/core": "^21.2.20",
    "@angular/forms": "^21.2.20",
    "@angular/router": "^21.2.20",
    "@hono/eslint-config": "^2.1.0",
    "@hono/zod-validator": "^0.8.0",
    "@rdlabo/eslint-plugin-rules": "^21.2.6",
    "@types/node": "^22.19.21",
    "ai": "^6.0.204",
    "ai-gateway-provider": "^3.1.3",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.39.4",
    "hono": "^4.6.0",
    "jose": "^6.2.3",
    "mysql2": "3.24.3",
    "np": "^8.0.4",
    "prettier": "^3.8.4",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.61.1",
    "vitest": "^2.1.0",
    "zod": "^4.4.3"
  }
}
